# Project-wide naming and region for Beacon (docs/CLOUD-DEVOPS-DESIGN.md §5.3).
# Workflows load this file into their environment; Terraform receives the
# values as TF_VAR_* variables. This is the single place these names are set.
#
# The AWS account is shared, so every name must be unique to this project:
#   NAME_PREFIX      most resources: S3 buckets, ALB/TG/ASG/RDS names, SSM
#                    paths, log groups, and the Project tag. Kept short because
#                    ALB and target group names max out at 32 characters.
#   IAM_NAME_PREFIX  IAM roles, policies, and instance profiles. The account
#                    requires every IAM role name to start with "cloudbatch818-".
#   GITHUB_OIDC_SUB_PREFIX
#                    Start of the OIDC "sub" claim GitHub issues for this repo.
#                    The repo uses immutable subjects (owner@id/repo@id), so a
#                    deleted-and-recreated repo with the same name can't assume
#                    these roles. Full claim: <prefix>:environment:<name>.
#                    Check: gh api repos/loriamichaelj/beacon/actions/oidc/customization/sub
#
# Every KEY=value here is exported to workflow steps as KEY and as
# TF_VAR_<key in lowercase>.

AWS_REGION=us-east-1
NAME_PREFIX=loria-beacon
IAM_NAME_PREFIX=cloudbatch818-loria-beacon
GITHUB_OIDC_SUB_PREFIX=repo:loriamichaelj@165821667/beacon@1382087094
