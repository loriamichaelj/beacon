# Copy to .env for local development. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://beacon:beacon@localhost:5434/beacon
PORT=8000
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000
READINESS_DB_TIMEOUT_SECONDS=1.0
CORS_ALLOWED_ORIGINS=
APP_VERSION=dev
GIT_SHA=unknown
DB_SSL=disable
DB_SSL_ROOT_CERT=
